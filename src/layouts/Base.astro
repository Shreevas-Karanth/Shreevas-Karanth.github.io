---
// Page shell: <head>, sticky nav with theme toggle, and footer. Used by the home page and the blog.
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props { title?: string; description?: string; type?: 'website' | 'article' }
const {
  title = 'Shreevas M Karanth',
  description = 'Shreevas M Karanth — Associate Architect with 12 years building Java / Spring Boot platforms, event-driven systems and AI-assisted modernization.',
  type = 'website',
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const onBlog = Astro.url.pathname.startsWith('/blog');
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content={type}>
<meta property="og:title" content={isHome ? 'Shreevas M Karanth · Associate Architect' : title}>
<meta property="og:description" content={isHome ? 'Java & Spring Boot architect. Event-driven systems, enterprise integrations and AI-assisted legacy modernization.' : description}>
<meta property="og:url" content={canonical}>
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/rss+xml" title="Shreevas M Karanth · Writing" href="/rss.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230E5E7A'/%3E%3Ctext x='32' y='42' font-family='monospace' font-size='26' font-weight='700' fill='white' text-anchor='middle'%3ESK%3C/text%3E%3C/svg%3E">
<!-- Apply the saved theme before first paint so there is no light/dark flash. -->
<script is:inline>
  try { var t = localStorage.getItem("theme"); if (t) document.documentElement.setAttribute("data-theme", t); } catch (e) {}
</script>
</head>
<body>

<header class="nav" id="top">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Home"><span class="brand-mark">SK</span><span class="brand-name">Shreevas Karanth</span></a>
    <nav class="nav-links" aria-label="Sections">
      <a href="/#about">About</a>
      <a href="/#expertise">Expertise</a>
      <a href="/#architecture">Architecture</a>
      <a href="/#experience">Experience</a>
      <a href="/#impact">AI Impact</a>
      <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Blog</a>
      <a href="/#contact">Contact</a>
    </nav>
    <button class="theme-btn" id="themeBtn" type="button" aria-label="Toggle colour theme">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
    </button>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="footer">
  <div class="wrap foot-inner">
    <span>© <span id="yr">{year}</span> {profile.name}</span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<script>
  const root = document.documentElement;
  document.getElementById('themeBtn')?.addEventListener('click', () => {
    const cur = root.getAttribute('data-theme') ||
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = cur === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  // Keep the footer year current between rebuilds.
  const yr = document.getElementById('yr');
  if (yr) yr.textContent = String(new Date().getFullYear());
</script>
</body>
</html>
