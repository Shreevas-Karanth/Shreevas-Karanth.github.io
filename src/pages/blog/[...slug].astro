---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Posts are newest first, so the next item in the list is the older post.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, draft } = post.data;
const { Content } = await render(post);
---
<Base title={`${title} · Shreevas M Karanth`} description={description} type="article">
  <article class="wrap post">
    <a class="post-back" href="/blog/">← All posts</a>
    <header class="post-head">
      <p class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {updated && <><span aria-hidden="true">·</span><span>Updated {formatDate(updated)}</span></>}
        {draft && <span class="draft-badge">Draft</span>}
      </p>
      <h1>{title}</h1>
      <p class="post-lede">{description}</p>
      {tags.length > 0 && <ul class="chips sm">{tags.map((t) => <li>{t}</li>)}</ul>}
    </header>

    <div class="post-body">
      <Content />
    </div>

    {(newer || older) && (
      <nav class="post-pager" aria-label="More posts">
        {older ? <a href={`/blog/${older.id}/`}><span>← Older</span>{older.data.title}</a> : <span />}
        {newer && <a class="next" href={`/blog/${newer.id}/`}><span>Newer →</span>{newer.data.title}</a>}
      </nav>
    )}
  </article>
</Base>
