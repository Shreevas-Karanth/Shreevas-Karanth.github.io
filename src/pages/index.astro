---
// Section order follows the reader's questions: who → specialisation → business problems →
// architecture → delivery → leadership → what's different (AI) → contact.
// <Writing /> shows the latest blog posts and renders nothing until a post is published.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import WhatIDo from '../components/WhatIDo.astro';
import ProblemsSolved from '../components/ProblemsSolved.astro';
import Architecture from '../components/Architecture.astro';
import Approach from '../components/Approach.astro';
import Experience from '../components/Experience.astro';
import Leadership from '../components/Leadership.astro';
import AIImpact from '../components/AIImpact.astro';
import Writing from '../components/Writing.astro';
import Contact from '../components/Contact.astro';
---
<Base>
  <Hero />
  <About />
  <WhatIDo />
  <ProblemsSolved />
  <Architecture />
  <Approach />
  <Experience />
  <Leadership />
  <AIImpact />
  <Writing />
  <Contact />
</Base>
