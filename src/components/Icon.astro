---
// Filled 24px profile/contact icon; paths live in src/data/profile.ts.
import { icons, type IconName } from '../data/profile';

interface Props { name: IconName }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor" set:html={icons[name]} />
